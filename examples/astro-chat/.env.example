# Either key is enough. If both are set, each model uses its own provider.

# OpenRouter — used by the default model (xiaomi/mimo-v2.5-pro, paid but cheap)
# and by the free models in the picker. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Vercel AI Gateway — used by the Claude models in the picker.
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=
