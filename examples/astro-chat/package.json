{
  "name": "example-astro-chat",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "command -v portless >/dev/null 2>&1 || (echo '\\nportless is required but not installed. Run: npm i -g portless\\nSee: https://github.com/vercel-labs/portless\\n' && exit 1)",
    "dev": "portless astro-chat-demo.json-render astro dev",
    "build": "astro build",
    "start": "node ./dist/server/entry.mjs",
    "preview": "astro preview",
    "check-types": "astro check --minimumSeverity error"
  },
  "dependencies": {
    "@ai-sdk/react": "4.0.82",
    "@astrojs/node": "11.1.4",
    "@astrojs/react": "6.0.4",
    "@json-render/core": "workspace:*",
    "@json-render/react": "workspace:*",
    "ai": "7.0.79",
    "astro": "7.2.7",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "19.2.3",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.7.2"
  }
}
